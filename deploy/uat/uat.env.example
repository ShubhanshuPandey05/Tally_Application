# TallyFlow UAT environment.
#
#   cp uat.env.example uat.env      # then fill in the four marked values
#
# uat.env holds real credentials. It is gitignored; keep it that way, and keep
# a copy of TALLYFLOW_SECRET_KEYS somewhere other than this server.

# --- Public hostname ------------------------------------------------------
# The name connectors and phones dial. Its A record must point at this host,
# with ports 80 and 443 open, or Caddy cannot obtain a certificate.
# Use `localhost` for a smoke test on the build machine.
UAT_DOMAIN=uat-tallyflow.theshubhanshu.dev

# --- Database -------------------------------------------------------------
# Read by the postgres container. Generate the password, do not invent one:
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_USER=tallyflow
POSTGRES_PASSWORD=            # <-- REQUIRED
POSTGRES_DB=tallyflow

# Read by the app and the migrator. `db` is the compose service name, and the
# asyncpg driver is required -- preflight refuses anything else.
TALLYFLOW_DATABASE_URL=postgresql+asyncpg://tallyflow:CHANGE_ME@db:5432/tallyflow

# --- Environment ----------------------------------------------------------
# "prod" on purpose, even for UAT: it is what disables /docs and the debug
# error bodies. Testing with production behaviour is the point of UAT.
TALLYFLOW_ENVIRONMENT=prod
TALLYFLOW_DEBUG=false

# --- Secrets --------------------------------------------------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
TALLYFLOW_JWT_SECRET=         # <-- REQUIRED, 32+ chars

# Encrypts connector pairing secrets at rest.
# LOSING THIS MEANS EVERY PILOT CUSTOMER RE-PAIRS THEIR PC. Back it up off-host.
TALLYFLOW_SECRET_KEYS=        # <-- REQUIRED

# --- Management portal ----------------------------------------------------
# Signups do not provision themselves. A new customer installs everything and
# signs in to an account entitled to nothing, and somebody at https://<domain>
# /portal decides how many people and how many companies it covers.
#
# Portal accounts are never self-service, so the first one has to come from
# here. It is created once, on the next start, and only when no portal account
# exists at all -- a restart never resets the password of a live account back to
# whatever this file still says. The seeded owner is forced to change it at
# first sign-in for exactly that reason: this value is readable by anyone who
# can read this file.
#
# Leave both blank once the first owner exists and has signed in. Further
# accounts are added inside the portal, where the action is attributable to a
# person rather than to a container's environment.
#   python -c "import secrets;print(secrets.token_urlsafe(18))"
TALLYFLOW_PORTAL_BOOTSTRAP_EMAIL=
TALLYFLOW_PORTAL_BOOTSTRAP_PASSWORD=

# --- The demo account -------------------------------------------------------
# A shared, read-only showroom: an invented business with two financial years of
# books, no connector, and no sign-up. Turn it on only where strangers are meant
# to reach it -- this is a published login, and the app offers a one-tap
# "Explore the demo" button wherever it is enabled.
#
# Everything about it is an ordinary account, which is what keeps the demo
# honest: the same endpoints, the same reports, the same code. It is refused
# every *change* -- nobody signing in can unlink its company, revoke its
# connector, invite anybody or change the shared password.
#
# The books are seeded at startup and extended each day so they always end
# today. The first seed of a fresh database writes a few thousand vouchers and
# takes a few seconds.
TALLYFLOW_DEMO_ENABLED=false
TALLYFLOW_DEMO_EMAIL=demo@tallyflow.in
TALLYFLOW_DEMO_PASSWORD=
# How many financial years of history to invent.
TALLYFLOW_DEMO_YEARS=2

# What the approval form pre-fills. Suggestions only -- the real ceilings are
# agreed per customer and stored on their account.
TALLYFLOW_DEFAULT_MAX_COMPANIES=3
TALLYFLOW_DEFAULT_MAX_USERS=5

# The portal itself is served by Caddy from /srv/portal (see the Caddyfile and
# web.Dockerfile), not by the API. To stop serving it from a public host, drop
# the `handle_path /portal*` block -- the API stays up either way.

# --- Diagnostics ----------------------------------------------------------
# The portal's support view. Every captured line goes to an in-memory ring for
# the live tail; only WARNING and above is written down and survives a redeploy.
TALLYFLOW_LOG_CAPTURE_LEVEL=INFO
TALLYFLOW_LOG_PERSIST_LEVEL=WARNING
TALLYFLOW_LOG_RETENTION_DAYS=30

# Logs customers' connectors push over the socket they already hold open. Off
# makes the backend ignore those frames; connectors keep sending them and
# nothing breaks, which is what makes it safe to flip during an incident.
TALLYFLOW_CONNECTOR_LOGS_ENABLED=true
TALLYFLOW_CONNECTOR_LOG_RETENTION_DAYS=14

# --- Scale ----------------------------------------------------------------
# Blank is correct for UAT: one API container, so there is nothing to route
# between. Needed only when a second replica exists.
TALLYFLOW_REDIS_URL=

# --- Connector fleet ------------------------------------------------------
TALLYFLOW_HEARTBEAT_INTERVAL_SECONDS=30
TALLYFLOW_MAX_JOBS_PER_CONNECTOR=2
TALLYFLOW_DEFAULT_JOB_TIMEOUT_SECONDS=60
TALLYFLOW_HEAVY_JOB_TIMEOUT_SECONDS=180

# --- Freshness ------------------------------------------------------------
TALLYFLOW_SNAPSHOT_STALE_AFTER_SECONDS=900
TALLYFLOW_MIN_REFRESH_INTERVAL_SECONDS=30
TALLYFLOW_REFRESH_WORKER_ENABLED=true
TALLYFLOW_REFRESH_WORKER_INTERVAL_SECONDS=60
TALLYFLOW_REFRESH_BATCH_SIZE=25

# --- History sync ---------------------------------------------------------
# The safety knob. Asking a desktop TallyPrime for years of vouchers in one
# export is what wedges it, and that PC is usually the shop's till. For a first
# pilot, 3 is kinder than the default 6 and costs only a slower first sync.
TALLYFLOW_SYNC_CHUNK_MONTHS=3
# 1, not 4: only the currently-open financial year is reachable today (see the
# known limitation in UAT.md), so asking for four years buys nothing and spends
# the customer's Tally on windows that return nothing.
TALLYFLOW_SYNC_MAX_HISTORY_YEARS=1
TALLYFLOW_SYNC_CHUNK_PAUSE_SECONDS=3
TALLYFLOW_SYNC_CHUNK_TIMEOUT_SECONDS=300
TALLYFLOW_SYNC_INVENTORY_DAYS=400
TALLYFLOW_SYNC_DELTA_INTERVAL_SECONDS=300
TALLYFLOW_SYNC_RECONCILE_DAYS=90
TALLYFLOW_SYNC_RECONCILE_INTERVAL_SECONDS=86400
TALLYFLOW_SYNC_AUTO_START=true

# --- Public statistics -----------------------------------------------------
# The marketing site's hero prints four aggregate counts -- active businesses,
# paired Tally PCs, companies being read, and how many of those PCs are
# connected right now -- fetched from GET /v1/public/stats. It is the only route
# in the product that reads customer data without a token. Nothing per-customer
# is exposed: four integers and a timestamp.
#
# Off makes the endpoint 404 and the site simply stops drawing the row. Reach
# for it if publishing a customer count stops being something you want to do;
# it needs no code change and no rebuild of the site.
TALLYFLOW_PUBLIC_STATS_ENABLED=true
# How long one computed set of counts is reused. Every visitor asks for these,
# so without the cache a crawler turns a static page into four aggregate
# queries per hit against the database the phones read from.
TALLYFLOW_PUBLIC_STATS_TTL_SECONDS=60
# How recently a connector must have been heard from to count as connected.
# Generous next to the heartbeat, so one dropped beat on a shop's broadband
# does not make the public number flicker.
TALLYFLOW_PUBLIC_STATS_ONLINE_WINDOW_SECONDS=300

# --- HTTP -----------------------------------------------------------------
# Only needed if a browser calls the API (Flutter web). Native apps do not
# send Origin, so leave it blank for a phone-only pilot.
TALLYFLOW_CORS_ORIGINS=
TALLYFLOW_RATE_LIMIT_PER_MINUTE=120
TALLYFLOW_AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Releases and updates -------------------------------------------------
# The backend answers "is this client current?" inline: on every HTTP response
# to the app, and on every WebSocket frame to a connector. Nothing polls.
#
# Left blank it finds /srv/downloads/manifest.json, which docker-compose already
# mounts, so the normal deployment needs nothing here. Blank and not found means
# version checks are simply off -- a missing manifest must never be able to lock
# the fleet out of their own books.
TALLYFLOW_RELEASE_MANIFEST_PATH=

# The two kill switches, both default true.
#
# ENFORCE_MIN_APP_VERSION=false is what to reach for if a floor published by
# mistake has locked users out. It restores service immediately -- the advisory
# headers keep flowing, only the 426 stops -- without waiting for a corrected
# manifest to reach every phone.
#
# PUSH_CONNECTOR_UPDATES=false stops the backend telling connectors to install a
# new build over the socket. They fall back to their own six-hourly manifest
# poll, so updates still happen, just slowly.
TALLYFLOW_ENFORCE_MIN_APP_VERSION=true
TALLYFLOW_PUSH_CONNECTOR_UPDATES=true
