<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch screen before Android 12: the app's tile, centred on white.

  White in dark mode too, on purpose. The app's skin is chosen in Profile and
  never follows the system (see CLAUDE.md), and this screen cannot read that
  choice -- so it matches the in-app splash, which is white on every skin, and
  the handover to Flutter's first frame is invisible. `splash_logo` is
  generated by tools/brand/generate.py at the size `_SplashScreen` paints.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
