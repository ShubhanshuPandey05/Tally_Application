<?xml version="1.0" encoding="utf-8"?>
<!--
  The dark-mode twin of values-v31/styles.xml, kept identical on purpose: the
  splash is white whatever the system says, to match the in-app splash. Without
  this file a dark-mode phone on Android 12+ would fall back to values-night
  and show the system's dark splash.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
