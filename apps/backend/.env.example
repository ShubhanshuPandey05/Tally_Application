# TallyFlow backend configuration.
# Copy to .env for local development. In production these are real environment
# variables -- never a file baked into an image.

# --- Environment ----------------------------------------------------------
TALLYFLOW_ENVIRONMENT=dev
TALLYFLOW_DEBUG=false

# --- Secrets (MUST be set in production) ----------------------------------
# Signs access tokens. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this signs everyone out; it does not lose any data.
TALLYFLOW_JWT_SECRET=

# Encrypts connector pairing secrets at rest. Comma-separated for rotation:
# the first key encrypts, all keys are tried when decrypting.
# LOSING THIS MEANS EVERY CONNECTOR MUST BE RE-PAIRED -- back it up separately
# from the database, or an attacker with a database dump gains nothing.
TALLYFLOW_SECRET_KEYS=

# --- Database -------------------------------------------------------------
# SQLite is for local development only. Production is Postgres.
TALLYFLOW_DATABASE_URL=sqlite+aiosqlite:///./tallyflow.db
# TALLYFLOW_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/tallyflow
TALLYFLOW_DB_POOL_SIZE=20
TALLYFLOW_DB_MAX_OVERFLOW=10

# --- Horizontal scale -----------------------------------------------------
# Leave blank to run a single instance. Set it to run several replicas: a
# connector holds one WebSocket to one instance, and this is what lets any
# instance route a job to the one holding the socket.
TALLYFLOW_REDIS_URL=
# TALLYFLOW_REDIS_URL=redis://localhost:6379/0

# Must be unique per running process. Kubernetes: use the pod name.
# TALLYFLOW_INSTANCE_ID=

# --- Connector fleet ------------------------------------------------------
TALLYFLOW_HEARTBEAT_INTERVAL_SECONDS=30
# TallyPrime serves one request at a time. Raising this does not make anything
# faster; it queues inside Tally and freezes the shop's own screen.
TALLYFLOW_MAX_JOBS_PER_CONNECTOR=2
TALLYFLOW_DEFAULT_JOB_TIMEOUT_SECONDS=60
TALLYFLOW_HEAVY_JOB_TIMEOUT_SECONDS=180

# --- Freshness ------------------------------------------------------------
# How old a snapshot may get before a read refreshes it.
TALLYFLOW_SNAPSHOT_STALE_AFTER_SECONDS=900
# Floor between forced refreshes of one company, so pull-to-refresh cannot be
# used to hammer a customer's PC.
TALLYFLOW_MIN_REFRESH_INTERVAL_SECONDS=30
TALLYFLOW_REFRESH_WORKER_ENABLED=true
TALLYFLOW_REFRESH_WORKER_INTERVAL_SECONDS=60
TALLYFLOW_REFRESH_BATCH_SIZE=25

# --- History sync ---------------------------------------------------------
# A company's books are read in slices this many months long, newest first.
# THIS IS THE SAFETY KNOB. Asking a desktop TallyPrime for four years of
# vouchers in one export is what wedges it, and that PC is usually the shop's
# till. Lower it for customers with heavy books; never raise it to "speed
# things up".
TALLYFLOW_SYNC_CHUNK_MONTHS=6
# How far back a backfill reaches, even when the books start earlier.
TALLYFLOW_SYNC_MAX_HISTORY_YEARS=4
# Breather between slices, so back-to-back exports are not felt at the counter.
TALLYFLOW_SYNC_CHUNK_PAUSE_SECONDS=3
TALLYFLOW_SYNC_CHUNK_TIMEOUT_SECONDS=300
# Slices newer than this carry stock lines; older ones do not. Inventory detail
# is most of a voucher export's size and no report reads it on old invoices.
TALLYFLOW_SYNC_INVENTORY_DAYS=400
# Floor between "has anything changed?" checks for one company.
TALLYFLOW_SYNC_DELTA_INTERVAL_SECONDS=300
# A change-id delta reports what changed but never what was deleted, so this
# recent window is re-read in full on the interval below and reconciled.
TALLYFLOW_SYNC_RECONCILE_DAYS=90
TALLYFLOW_SYNC_RECONCILE_INTERVAL_SECONDS=86400
# Whether linking a company starts its history read automatically.
TALLYFLOW_SYNC_AUTO_START=true

# --- Management portal ----------------------------------------------------
# A signup provisions nothing: a new account can sign in and add nothing until
# somebody in the management portal approves it and says how many people and how
# many companies it covers. The portal is its own app (apps/portal) -- served by
# Caddy in a deployment, and by `python run.py portal` locally.
#
# Portal accounts are never self-service, so the first one is seeded from here.
# It is created only when no portal account exists at all, and never overwrites
# one that does -- a restart must not reset a live account's password back to
# whatever this file still says. `run.py init` fills these in for you.
TALLYFLOW_PORTAL_BOOTSTRAP_EMAIL=dev@tallyflow.in
TALLYFLOW_PORTAL_BOOTSTRAP_PASSWORD=

# --- The demo account -------------------------------------------------------
# A shared, read-only showroom: an invented business with two financial years of
# books, no connector, and no sign-up. Turn it on only where strangers are meant
# to reach it -- this is a published login, and the app offers a one-tap
# "Explore the demo" button wherever it is enabled.
#
# Everything about it is an ordinary account, which is what keeps the demo
# honest: the same endpoints, the same reports, the same code. It is refused
# every *change* -- nobody signing in can unlink its company, revoke its
# connector, invite anybody or change the shared password.
#
# The books are seeded at startup and extended each day so they always end
# today. The first seed of a fresh database writes a few thousand vouchers and
# takes a few seconds.
TALLYFLOW_DEMO_ENABLED=false
TALLYFLOW_DEMO_EMAIL=demo@tallyflow.in
TALLYFLOW_DEMO_PASSWORD=
# How many financial years of history to invent.
TALLYFLOW_DEMO_YEARS=2

# What the approval form pre-fills. Suggestions -- the real ceilings live on
# each customer's own account.
TALLYFLOW_DEFAULT_MAX_COMPANIES=3
TALLYFLOW_DEFAULT_MAX_USERS=5

# --- Diagnostics ----------------------------------------------------------
# What the portal's support view can show.
#
# Every captured line lands in an in-memory ring for the live tail; only
# WARNING and above is written to `server_logs`, where it survives a redeploy.
# Lowering the persist level to INFO writes a database row per request, on the
# same database that serves customers' reports -- do not, except briefly.
TALLYFLOW_LOG_RING_CAPACITY=5000
TALLYFLOW_LOG_CAPTURE_LEVEL=INFO
TALLYFLOW_LOG_PERSIST_LEVEL=WARNING
TALLYFLOW_LOG_RETENTION_DAYS=30

# Logs pushed by customers' connectors over the socket they already hold open.
# Off makes the backend ignore those frames -- connectors keep sending them and
# nothing breaks, which is what makes this safe to flip during an incident.
TALLYFLOW_CONNECTOR_LOGS_ENABLED=true
TALLYFLOW_CONNECTOR_LOG_RETENTION_DAYS=14
# Lines held in memory between writes, across the whole fleet. Full means the
# newest are refused: one flooding connector must not evict every other
# customer's lines.
TALLYFLOW_CONNECTOR_LOG_BUFFER=20000

# --- Public statistics -----------------------------------------------------
# The marketing site's hero prints four aggregate counts -- active businesses,
# paired Tally PCs, companies being read, and how many of those PCs are
# connected right now -- fetched from GET /v1/public/stats. It is the only route
# in the product that reads customer data without a token. Nothing per-customer
# is exposed: four integers and a timestamp.
#
# Off makes the endpoint 404 and the site simply stops drawing the row. Reach
# for it if publishing a customer count stops being something you want to do;
# it needs no code change and no rebuild of the site.
TALLYFLOW_PUBLIC_STATS_ENABLED=true
# How long one computed set of counts is reused. Every visitor asks for these,
# so without the cache a crawler turns a static page into four aggregate
# queries per hit against the database the phones read from.
TALLYFLOW_PUBLIC_STATS_TTL_SECONDS=60
# How recently a connector must have been heard from to count as connected.
# Generous next to the heartbeat, so one dropped beat on a shop's broadband
# does not make the public number flicker.
TALLYFLOW_PUBLIC_STATS_ONLINE_WINDOW_SECONDS=300

# --- HTTP -----------------------------------------------------------------
TALLYFLOW_CORS_ORIGINS=
TALLYFLOW_RATE_LIMIT_PER_MINUTE=120
TALLYFLOW_AUTH_RATE_LIMIT_PER_MINUTE=10
