# TallyFlow backend configuration.
# Copy to .env for local development. In production these are real environment
# variables -- never a file baked into an image.

# --- Environment ----------------------------------------------------------
TALLYFLOW_ENVIRONMENT=dev
TALLYFLOW_DEBUG=false

# --- Secrets (MUST be set in production) ----------------------------------
# Signs access tokens. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this signs everyone out; it does not lose any data.
TALLYFLOW_JWT_SECRET=

# Encrypts connector pairing secrets at rest. Comma-separated for rotation:
# the first key encrypts, all keys are tried when decrypting.
# LOSING THIS MEANS EVERY CONNECTOR MUST BE RE-PAIRED -- back it up separately
# from the database, or an attacker with a database dump gains nothing.
TALLYFLOW_SECRET_KEYS=

# --- Database -------------------------------------------------------------
# SQLite is for local development only. Production is Postgres.
TALLYFLOW_DATABASE_URL=sqlite+aiosqlite:///./tallyflow.db
# TALLYFLOW_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/tallyflow
TALLYFLOW_DB_POOL_SIZE=20
TALLYFLOW_DB_MAX_OVERFLOW=10

# --- Horizontal scale -----------------------------------------------------
# Leave blank to run a single instance. Set it to run several replicas: a
# connector holds one WebSocket to one instance, and this is what lets any
# instance route a job to the one holding the socket.
TALLYFLOW_REDIS_URL=
# TALLYFLOW_REDIS_URL=redis://localhost:6379/0

# Must be unique per running process. Kubernetes: use the pod name.
# TALLYFLOW_INSTANCE_ID=

# --- Connector fleet ------------------------------------------------------
TALLYFLOW_HEARTBEAT_INTERVAL_SECONDS=30
# TallyPrime serves one request at a time. Raising this does not make anything
# faster; it queues inside Tally and freezes the shop's own screen.
TALLYFLOW_MAX_JOBS_PER_CONNECTOR=2
TALLYFLOW_DEFAULT_JOB_TIMEOUT_SECONDS=60
TALLYFLOW_HEAVY_JOB_TIMEOUT_SECONDS=180

# --- Freshness ------------------------------------------------------------
# How old a snapshot may get before a read refreshes it.
TALLYFLOW_SNAPSHOT_STALE_AFTER_SECONDS=900
# Floor between forced refreshes of one company, so pull-to-refresh cannot be
# used to hammer a customer's PC.
TALLYFLOW_MIN_REFRESH_INTERVAL_SECONDS=30
TALLYFLOW_REFRESH_WORKER_ENABLED=true
TALLYFLOW_REFRESH_WORKER_INTERVAL_SECONDS=60
TALLYFLOW_REFRESH_BATCH_SIZE=25

# --- HTTP -----------------------------------------------------------------
TALLYFLOW_CORS_ORIGINS=
TALLYFLOW_RATE_LIMIT_PER_MINUTE=120
TALLYFLOW_AUTH_RATE_LIMIT_PER_MINUTE=10
